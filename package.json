{
  "name": "westos-storefront",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/run-framework.mjs dev",
    "build": "node scripts/run-framework.mjs build",
    "payments": "node --env-file-if-exists=.env.local --experimental-strip-types server/payment-api.ts",
    "check": "tsc --noEmit && node --experimental-strip-types tests/commerce.test.ts && node --experimental-strip-types tests/turntable.test.ts && node --experimental-strip-types tests/youpi.test.ts && node --experimental-strip-types tests/payment-ledger.test.ts && node --experimental-strip-types tests/payment-api.test.ts && node --experimental-strip-types tests/operations.test.ts && node --experimental-strip-types tests/inventory.test.ts && node --experimental-strip-types tests/media.test.ts",
    "start": "node --import ./scripts/sites-env.mjs ./node_modules/wrangler/bin/wrangler.js dev --config dist/server/wrangler.json --local --persist-to .wrangler/state --ip 127.0.0.1 --inspector-port 0",
    "install:ci": "node scripts/install-ci.mjs",
    "db:generate": "drizzle-kit generate"
  },
  "dependencies": {
    "next": "^16.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "drizzle-orm": "0.45.2"
  },
  "devDependencies": {
    "typescript": "^5.9.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@cloudflare/vite-plugin": "1.37.1",
    "@cloudflare/workers-types": "4.20260515.1",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "drizzle-kit": "0.31.10",
    "react-server-dom-webpack": "19.2.6",
    "vinext": "1.0.0-beta.5",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "overrides": {
    "miniflare": {
      "sharp": "0.35.4"
    }
  }
}
