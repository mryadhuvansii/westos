# Frontend build setting. Leave empty for the standalone sample storefront.
NEXT_PUBLIC_WESTOS_API_URL=

# Hosted admin: configure this as a Sites runtime secret, never NEXT_PUBLIC_.
# The first matching owner's setup locks access to their stable platform user ID.
WESTOS_OWNER_EMAIL=

# Optional trusted order-service access to /api/internal/inventory.
# Keep empty until an order service is connected; use at least 32 random characters.
# Configure privately in the Worker environment, never in the browser.
WESTOS_INVENTORY_INTERNAL_KEY=

# Private payment bridge. Never use NEXT_PUBLIC_ for any secret below.
WESTOS_PAYMENTS_ENABLED=false
WESTOS_STOREFRONT_ORIGIN=http://127.0.0.1:3000
WESTOS_PAYMENT_PORT=8787
WESTOS_PAYMENT_DB=.local/payments.sqlite
WESTOS_CHECKOUT_INTERNAL_KEY=
YOUPI_API_URL=http://127.0.0.1:6100
YOUPI_CHECKOUT_ORIGIN=http://127.0.0.1:7000
YOUPI_MERCHANT_ID=
YOUPI_MERCHANT_KEY=
YOUPI_WEBHOOK_SECRET=
